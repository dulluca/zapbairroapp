# Firebase iOS SDK 12.x (firebase_core 4.x) exige iOS 15.0 como minimo.
# Este valor precisa continuar igual ao IPHONEOS_DEPLOYMENT_TARGET do Runner.xcodeproj.
platform :ios, '15.0'

# CocoaPods analytics deixa o build mais lento sem beneficio nenhum aqui.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} nao existe. Rode `flutter pub get` (ou `flutter build ios --config-only`) antes do `pod install`."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT nao encontrado em #{generated_xcode_build_settings_path}. Apague o Generated.xcconfig e rode `flutter pub get`."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Alguns pods trazem um deployment target menor que o do app, o que gera
      # avisos e, no caso do Firebase, erro de link. Alinha todo mundo em 15.0.
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current.nil? || current.to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
